{
 "detect_secrets_version": "v1.5.0",
 "denylist": [
  "api_?key",
  "auth_?key",
  "service_?key",
  "account_?key",
  "db_?key",
  "database_?key",
  "priv_?key",
  "private_?key",
  "client_?key",
  "db_?pass",
  "database_?pass",
  "key_?pass",
  "password",
  "passwd",
  "pwd",
  "secret",
  "contrase\u00f1a",
  "contrasena"
 ],
 "rules": [
  {
   "id": "ds-keyword-colon",
   "regex": "(api_?key|auth_?key|service_?key|account_?key|db_?key|database_?key|priv_?key|private_?key|client_?key|db_?pass|database_?pass|key_?pass|password|passwd|pwd|secret|contrase\u00f1a|contrasena)\\w*([]\\'\"]{0,2})?:\\s*([\\'\"`]?)((?=[^\\v\\'\\\"]*)(?=\\w+)[^\\v\\'\\\"]*[^\\v,\\'\\\"`])(\\3)",
   "ignorecase": true,
   "group": 4,
   "set": "config"
  },
  {
   "id": "ds-keyword-preceded-by-equal-comparison-signs-quotes-required",
   "regex": "([\\'\"`])((?=[^\\v\\'\\\"]*)(?=\\w+)[^\\v\\'\\\"]*[^\\v,\\'\\\"`])(\\1)\\s*[!=]{2,3}\\s*\\w*(api_?key|auth_?key|service_?key|account_?key|db_?key|database_?key|priv_?key|private_?key|client_?key|db_?pass|database_?pass|key_?pass|password|passwd|pwd|secret|contrase\u00f1a|contrasena)\\w*",
   "ignorecase": false,
   "group": 2,
   "set": "config"
  },
  {
   "id": "ds-keyword-equal-signs",
   "regex": "(api_?key|auth_?key|service_?key|account_?key|db_?key|database_?key|priv_?key|private_?key|client_?key|db_?pass|database_?pass|key_?pass|password|passwd|pwd|secret|contrase\u00f1a|contrasena)\\w*([]\\'\"]{0,2})?\\s*(={1,3}|!==?)\\s*([\\'\"`]?)((?=[^\\v\\'\\\"]*)(?=\\w+)[^\\v\\'\\\"]*[^\\v,\\'\\\"`])(\\4)",
   "ignorecase": true,
   "group": 5,
   "set": "config"
  },
  {
   "id": "ds-keyword-quotes-and-semicolon",
   "regex": "(api_?key|auth_?key|service_?key|account_?key|db_?key|database_?key|priv_?key|private_?key|client_?key|db_?pass|database_?pass|key_?pass|password|passwd|pwd|secret|contrase\u00f1a|contrasena)\\w*[^\\s]{0,50}?\\s*([\\'\"`])((?=[^\\v\\'\\\"]*)(?=\\w+)[^\\v\\'\\\"]*[^\\v,\\'\\\"`])(\\2);",
   "ignorecase": true,
   "group": 3,
   "set": "config"
  },
  {
   "id": "ds-keyword-colon-quotes-required",
   "regex": "(api_?key|auth_?key|service_?key|account_?key|db_?key|database_?key|priv_?key|private_?key|client_?key|db_?pass|database_?pass|key_?pass|password|passwd|pwd|secret|contrase\u00f1a|contrasena)\\w*([]\\'\"]{0,2})?:(\\s*)([\\'\"`])((?=[^\\v\\'\\\"]*)(?=\\w+)[^\\v\\'\\\"]*[^\\v,\\'\\\"`])(\\4)",
   "ignorecase": true,
   "group": 5,
   "set": "quotes_required"
  },
  {
   "id": "ds-keyword-equal-signs-quotes-required",
   "regex": "(api_?key|auth_?key|service_?key|account_?key|db_?key|database_?key|priv_?key|private_?key|client_?key|db_?pass|database_?pass|key_?pass|password|passwd|pwd|secret|contrase\u00f1a|contrasena)\\w*([]\\'\"]{0,2})?\\s*(={1,3}|!==?)\\s*([\\'\"`])((?=[^\\v\\'\\\"]*)(?=\\w+)[^\\v\\'\\\"]*[^\\v,\\'\\\"`])(\\4)",
   "ignorecase": true,
   "group": 5,
   "set": "quotes_required"
  },
  {
   "id": "ds-keyword-arrow-function-sign-quotes-required",
   "regex": "(api_?key|auth_?key|service_?key|account_?key|db_?key|database_?key|priv_?key|private_?key|client_?key|db_?pass|database_?pass|key_?pass|password|passwd|pwd|secret|contrase\u00f1a|contrasena)\\w*([]\\'\"]{0,2})?\\s*=>?\\s*([\\'\"`])((?=[^\\v\\'\\\"]*)(?=\\w+)[^\\v\\'\\\"]*[^\\v,\\'\\\"`])(\\3)",
   "ignorecase": true,
   "group": 4,
   "set": "quotes_required"
  },
  {
   "id": "ds-basic-auth",
   "regex": "://[^:/\\?\\#\\[\\]@!\\$\\&'\\(\\)\\*\\+,;=\\s]+:([^:/\\?\\#\\[\\]@!\\$\\&'\\(\\)\\*\\+,;=\\s]+)@",
   "ignorecase": false,
   "group": 1,
   "set": "basic_auth"
  }
 ]
}