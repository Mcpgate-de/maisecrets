#!/bin/bash
# maisecrets pre-push: the checks of seconds. The minutes run in CI, before any merge.
#   - refuses tag pushes (CI creates release tags from CHANGELOG.md)
#   - runs lint, the repository scan, the plugin lint, the release file sizes and the derived-counts check
# The unit tests (3.12 and 3.9), the belief replay and the hook harness run in the GitLab merge
# request pipeline (jobs unit, unit_python39, beliefs_can_fail_replay, harness_claude), and a red
# pipeline blocks the merge. Running them here too doubled every push to 10-15 minutes and, with
# parallel worktrees, pushed the load past 30 (2026-10-15). To run all of it locally:
# scripts/check_all.sh
set -u

new=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*) echo "pre-push: tag pushes are refused; CI tags releases from CHANGELOG.md"; exit 1 ;;
  esac
  # a commit on origin's main or next came through a merge request whose pipeline ran these checks: a push of it to
  # another remote (the bench host before a release gate) checks nothing new
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  [ -n "$(git for-each-ref --contains "$local_sha" --count=1 refs/remotes/origin/main refs/remotes/origin/next)" ] \
    || new=1
done
if echo "$*" | grep -q -- "--tags"; then echo "pre-push: --tags refused"; exit 1; fi
if [ "$new" = 0 ]; then echo "pre-push: every pushed commit is on origin already; nothing new to check"; exit 0; fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

if command -v ruff >/dev/null 2>&1; then
  ruff check --select E,F,W --line-length 120 maisecrets hooks harness tests scripts skills || { echo "pre-push: lint failed"; exit 1; }
fi
# GitLab's validate stage runs these too and skips every test job when one is red
python3 scripts/scan_tree.py >/dev/null || { python3 scripts/scan_tree.py | tail -5; echo "pre-push: the repository scan found a secret shape"; exit 1; }
python3 scripts/lint_plugin.py >/dev/null || { echo "pre-push: plugin lint failed"; exit 1; }
python3 scripts/check_release_sizes.py || { echo "pre-push: a file is over the size limit of the release tree"; exit 1; }
python3 scripts/derived_counts.py >/dev/null || { python3 scripts/derived_counts.py | grep BAD; echo "pre-push: a number in the docs is stale"; exit 1; }
exit 0
