#!/bin/bash
# maisecrets pre-push: the harness runs once per push, over the tip.
#   - refuses tag pushes (CI creates release tags from CHANGELOG.md)
#   - runs the repository scan, the plugin lint and the derived-counts check (seconds), then
#     the unit tests and the belief replay (each control's test must go red under its mutation)
#   - runs the hook harness when `claude` is available (it needs a login;
#     CI cannot run it, so the push is where it must pass)
# MAISECRETS_SKIP_HARNESS=1 skips the harness only. Nothing skips the tests.
set -u
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*) echo "pre-push: tag pushes are refused; CI tags releases from CHANGELOG.md"; exit 1 ;;
  esac
done
if echo "$*" | grep -q -- "--tags"; then echo "pre-push: --tags refused"; exit 1; fi

if command -v ruff >/dev/null 2>&1; then
  ruff check --select E,F,W --line-length 120 maisecrets hooks harness tests scripts skills || { echo "pre-push: lint failed"; exit 1; }
fi
# the checks of seconds first, the checks of minutes after: GitLab's validate stage runs these
# too and skips every test job when one is red (a secret-shaped test literal cost a pipeline,
# 2026-09-28)
python3 scripts/scan_tree.py >/dev/null || { python3 scripts/scan_tree.py | tail -5; echo "pre-push: the repository scan found a secret shape"; exit 1; }
python3 scripts/lint_plugin.py >/dev/null || { echo "pre-push: plugin lint failed"; exit 1; }
python3 scripts/derived_counts.py >/dev/null || { python3 scripts/derived_counts.py | grep BAD; echo "pre-push: a number in the docs is stale"; exit 1; }
python3 -m unittest discover -s tests -q || { echo "pre-push: unit tests failed"; exit 1; }
python3 scripts/replay_can_fail.py || { echo "pre-push: a control's test did not go red under its mutation"; exit 1; }

if [ "${MAISECRETS_SKIP_HARNESS:-0}" != "1" ] && command -v claude >/dev/null 2>&1; then
  echo "pre-push: running the hook harness (fake upstream, every scenario)"
  python3 harness/run.py || { echo "pre-push: harness failed"; exit 1; }
fi
exit 0
