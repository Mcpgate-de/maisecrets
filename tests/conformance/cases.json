  {
   "id": "phone-word-as-a-json-key",
   "input": "{\"customer\": {\"telefon\": \"0171 4829173\", \"build_number\": \"20261021\"}}",
   "kind": "normative",
   "channel": "tool",
   "regions": [
    "generic",
    "de"
   ],
   "languages": [
    "en",
    "de"
   ],
