   "kind": "normative",
   "input": "Street Address: 12 Oak Street SW\nCity: Springfield",
   "channel": "tool",
   "regions": [
    "generic",
    "us"
   ],
   "languages": [
    "en"
   ],
   "expected": [
    {
     "start": 16,
     "end": 32,
     "type": "ADDRESS"
    }
   ],
   "not_expected": [
    {
     "start": 33,
     "end": 50,
     "type": "ADDRESS"
    }
   ],
   "why": "a direction after the street type belongs to the street (BENCHMARKS.md, 2026-10-20)"
  },
