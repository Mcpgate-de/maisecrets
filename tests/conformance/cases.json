   "languages": [
    "en",
    "de"
   ],
   "expected": [
    {
     "start": 29,
     "end": 41,
     "type": "PHONE"
    }
   ],
   "not_expected": [],
   "why": "an emoji outside the BMP is one code point: the value starts at 29; a UTF-16 count (two units each) would give 31"
  },
